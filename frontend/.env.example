# Frontend Configuration

# API
REACT_APP_API_URL=http://localhost:8000/api
REACT_APP_API_TIMEOUT=30000

# Real-time Chat
REACT_APP_CHAT_SERVER=http://localhost:3000

# Environment
REACT_APP_ENV=development

# Feature Flags
REACT_APP_ENABLE_ANALYTICS=false
REACT_APP_ENABLE_STRIPE=false

# Google Analytics
REACT_APP_GOOGLE_ANALYTICS_ID=your_analytics_id

# Stripe
REACT_APP_STRIPE_PUBLIC_KEY=your_stripe_public_key

# Map
REACT_APP_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# App Settings
REACT_APP_MAX_UPLOAD_SIZE=10485760
REACT_APP_IMAGE_FORMATS=jpg,jpeg,png,gif
REACT_APP_MAX_PHOTOS=12

# Pagination
REACT_APP_ITEMS_PER_PAGE=20
REACT_APP_MAX_MESSAGE_LENGTH=5000
