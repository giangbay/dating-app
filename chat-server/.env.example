# Chat Server Configuration

# Server
PORT=3000
NODE_ENV=development
HOST=localhost

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=dating_user
DB_PASS=dating_password
DATABASE=dating_app

# Security
JWT_SECRET=your-jwt-secret-key
CORS_ORIGIN=http://localhost:3001,http://localhost:3000
CHAT_SERVER_SECRET=your-chat-secret

# Redis (optional, for pub/sub and caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0

# Logging
LOG_LEVEL=debug

# Socket.io
SOCKET_IO_PATH=/socket.io
SOCKET_IO_CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# Message Settings
MAX_MESSAGE_LENGTH=5000
MESSAGE_RETENTION_DAYS=30
TYPING_NOTIFICATION_TIMEOUT=3000

# Connection Settings
CONNECTION_TIMEOUT=60000
PING_INTERVAL=25000
PING_TIMEOUT=60000
